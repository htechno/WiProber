<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/monitor_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/iperf_title" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusableInTouchMode="true"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/serverField"
                    style="@style/IperfField"
                    android:hint="@string/iperf_server"
                    android:layout_weight="2.4">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/server"
                        style="@style/IperfEdit"
                        android:inputType="textUri"
                        android:maxLength="255" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/portField"
                    style="@style/IperfField"
                    android:hint="@string/iperf_port">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/port"
                        android:text="@string/iperf_default_port"
                        style="@style/IperfEdit"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <RadioGroup
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkedButton="@+id/tcp"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@id/tcp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/iperf_tcp" />
                    <RadioButton
                        android:id="@+id/udp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/iperf_udp" />
                </RadioGroup>

                <CheckBox
                    android:id="@+id/reverse"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:minHeight="48dp"
                    android:text="@string/iperf_reverse" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/durationField"
                    style="@style/IperfField"
                    android:hint="@string/iperf_duration">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/duration"
                        android:text="@string/iperf_default_duration"
                        style="@style/IperfEdit"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/streamsField"
                    style="@style/IperfField"
                    android:hint="@string/iperf_streams">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/streams"
                        android:text="@string/iperf_default_one"
                        style="@style/IperfEdit"
                        android:inputType="number" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:baselineAligned="false"
                android:orientation="horizontal">
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/intervalField"
                    style="@style/IperfField"
                    android:hint="@string/iperf_interval"
                    app:helperText="@string/iperf_interval_help">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/interval"
                        android:text="@string/iperf_default_one"
                        style="@style/IperfEdit"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/bitrateField"
                    style="@style/IperfField"
                    android:hint="@string/iperf_bitrate"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/bitrate"
                        android:text="@string/iperf_default_one"
                        style="@style/IperfEdit"
                        android:inputType="numberDecimal" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/commandField"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="3dp"
                android:layout_marginTop="10dp"
                android:hint="@string/iperf_command">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/command"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:gravity="start|top"
                    android:minLines="2"
                    android:maxLines="5"
                    android:maxLength="16384"
                    android:textSize="14sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/useFields"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="@string/iperf_use_fields"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/iperf_output"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="6dp"
                android:background="?attr/colorSurfaceVariant"
                android:fillViewport="true">
                <TextView
                    android:id="@+id/output"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="96dp"
                    android:fontFamily="monospace"
                    android:padding="8dp"
                    android:saveEnabled="false"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </HorizontalScrollView>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:text="@string/iperf_ready"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/runButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/iperf_start" />
    </LinearLayout>
</LinearLayout>
