<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="24dp"
    android:gravity="center_vertical" android:orientation="horizontal" android:foreground="?attr/selectableItemBackground">
    <TextView android:id="@+id/bssid" android:layout_width="128dp" android:layout_height="wrap_content"
        android:paddingHorizontal="2dp" android:paddingVertical="2dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="11sp"
        android:text="@string/monitor_bssid" android:fontFamily="monospace" />
    <TextView android:id="@+id/ssid" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
        android:paddingHorizontal="2dp" android:paddingVertical="2dp" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:textSize="12sp"
        android:text="@string/monitor_ssid" android:fontFamily="sans" />
    <TextView android:id="@+id/security" android:layout_width="44dp" android:layout_height="wrap_content"
        android:paddingHorizontal="2dp" android:paddingVertical="2dp" android:includeFontPadding="false" android:textSize="12sp"
        android:text="@string/monitor_table_security" android:contentDescription="@string/monitor_security" android:fontFamily="sans" />
    <TextView android:id="@+id/band" android:layout_width="30dp" android:layout_height="wrap_content"
        android:paddingHorizontal="2dp" android:paddingVertical="2dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="12sp"
        android:text="@string/monitor_table_band" android:fontFamily="sans" />
    <TextView android:id="@+id/channel" android:layout_width="27dp" android:layout_height="wrap_content"
        android:paddingHorizontal="2dp" android:paddingVertical="2dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="12sp"
        android:text="@string/monitor_table_channel" android:fontFamily="sans" />
    <TextView android:id="@+id/width" android:layout_width="40dp" android:layout_height="wrap_content"
        android:paddingHorizontal="2dp" android:paddingVertical="2dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="12sp"
        android:text="@string/monitor_table_width" android:fontFamily="sans" />
    <TextView android:id="@+id/rssi" android:layout_width="34dp" android:layout_height="wrap_content"
        android:paddingHorizontal="2dp" android:paddingVertical="2dp" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textSize="12sp"
        android:text="@string/monitor_table_rssi" android:fontFamily="monospace" />
</LinearLayout>
