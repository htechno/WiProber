<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="830dp" android:layout_height="wrap_content" android:minHeight="52dp"
    android:gravity="center_vertical" android:orientation="horizontal" android:background="?attr/selectableItemBackground">
    <TextView android:id="@+id/bssid" android:layout_width="140dp" android:layout_height="wrap_content"
        android:padding="8dp" android:maxLines="2" android:ellipsize="end" android:textSize="12sp"
        android:text="@string/monitor_bssid" android:fontFamily="monospace" />
    <TextView android:id="@+id/band" android:layout_width="48dp" android:layout_height="wrap_content"
        android:padding="8dp" android:maxLines="2" android:ellipsize="end" android:textSize="12sp"
        android:text="@string/monitor_table_band" android:fontFamily="sans" />
    <TextView android:id="@+id/channel" android:layout_width="48dp" android:layout_height="wrap_content"
        android:padding="8dp" android:maxLines="2" android:ellipsize="end" android:textSize="12sp"
        android:text="@string/monitor_table_channel" android:fontFamily="sans" />
    <TextView android:id="@+id/width" android:layout_width="54dp" android:layout_height="wrap_content"
        android:padding="8dp" android:maxLines="2" android:ellipsize="end" android:textSize="12sp"
        android:text="@string/monitor_table_width" android:fontFamily="sans" />
    <TextView android:id="@+id/rssi" android:layout_width="48dp" android:layout_height="wrap_content"
        android:padding="8dp" android:maxLines="2" android:ellipsize="end" android:textSize="12sp"
        android:text="@string/monitor_table_rssi" android:fontFamily="monospace" />
    <TextView android:id="@+id/security" android:layout_width="148dp" android:layout_height="wrap_content"
        android:padding="8dp" android:maxLines="2" android:ellipsize="end" android:textSize="12sp"
        android:text="@string/monitor_security" android:fontFamily="sans" />
    <TextView android:id="@+id/ssid" android:layout_width="180dp" android:layout_height="wrap_content"
        android:padding="8dp" android:maxLines="2" android:ellipsize="end" android:textSize="12sp"
        android:text="@string/monitor_ssid" android:fontFamily="sans" />
</LinearLayout>
